@model HomeService.Web.Models.Service

@{
    var categories =
        ViewBag.Categories
        as List<HomeService.Web.Models.ServiceCategory>;
}

<h2>
    Add Service
</h2>

<hr />

@using (Html.BeginForm())
{
    <div>

        <label>
            Category
        </label>

        <select name="CategoryId">

            @foreach (var item in categories)
            {
                <option value="@item.CategoryId">

                    @item.CategoryName

                </option>
            }

        </select>

    </div>

    <br />

    <div>

        <label>
            Service Name
        </label>

        @Html.TextBoxFor(
            x => x.ServiceName)

    </div>

    <br />

    <div>

        <label>
            Description
        </label>

        @Html.TextAreaFor(
            x => x.Description)

    </div>

    <br />

    <div>

        <label>
            Price
        </label>

        @Html.TextBoxFor(
            x => x.Price)

    </div>

    <br />

    <div>

        <label>
            Active
        </label>

        @Html.CheckBoxFor(
            x => x.IsActive)

    </div>

    <br />

    <button type="submit">

        Save Service

    </button>
}