@model List<HomeService.Web.Models.ServiceCategory>

<div class="container mt-5">

    <div class="text-center mb-4">
        <h2>Home Service Application</h2>
        <p class="text-muted">Choose a service category</p>
        <hr />
    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center">

                        <h5 class="card-title">
                            @item.CategoryName
                        </h5>

                        <p class="text-muted">
                            Category ID: @item.CategoryId
                        </p>

                        <a href="/services/list/@item.CategoryId"
                           class="btn btn-primary">
                            View Services
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>