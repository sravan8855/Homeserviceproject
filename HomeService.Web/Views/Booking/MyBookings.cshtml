@model List<HomeService.Web.Models.Booking>

<h2>
    My Bookings
</h2>

<hr />

<table border="1" cellpadding="15">

    <tr>

        <th>
            Booking Id
        </th>

        <th>
            Customer
        </th>

        <th>
            Booking Date
        </th>

        <th>
            Time
        </th>

        <th>
            Status
        </th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @item.BookingId
            </td>

            <td>
                @item.CustomerName
            </td>

            <td>
                @item.BookingDate.ToShortDateString()
            </td>

            <td>
                @item.BookingTime
            </td>

            <td>
                @item.BookingStatus
            </td>

        </tr>
    }

</table>

