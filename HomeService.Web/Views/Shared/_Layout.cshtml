<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/Homeservices.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <i class="bi bi-tools"></i> Services

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @*@Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })*@
            <a class="navbar-brand" href="/">
                🏠 HomeService
            </a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">

                    <li>
                        @Html.ActionLink(
                        "Home",
                        "Index",
                        "Home",
                        new { area = "" },
                        new { @class = "nav-link" })
                    </li>

                    <li>
                        @Html.ActionLink(
                        "Services",
                        "Categories",
                        "Services",
                        new { area = "" },
                        new { @class = "nav-link" })
                    </li>

                </ul>

                <ul class="navbar-nav">

                    @if (Session["UserName"] != null)
                    {
                        <li>

                                <a class="nav-link">
                                 👋 Welcome,
                                  <strong>@Session["UserName"]</strong>
                                </a>

                        </li>

                        <li>

                            <a class="nav-link"
                               href="/booking/mybookings">

                                My Bookings

                            </a>

                        </li>

                        <li>

                            <a class="nav-link"
                               href="/accounts/logout">

                                Logout

                            </a>

                        </li>
                    }
                    else
                    {
                        <ul class="navbar-nav">

                            <!-- CUSTOMER -->



                            <li>

                                <a class="nav-link btn-register"
                                   href="/accounts/register">

                                    Customer Register

                                </a>

                            </li>

                            <li>

                                <a class="nav-link btn-login"
                                   href="/accounts/login">

                                    Customer Login

                                </a>

                            </li>

                            <!-- PROVIDER -->

                            <li>

                                <a class="nav-link btn-register"
                                   href="/providers/register">

                                    Provider Register

                                </a>

                            </li>

                            <li>

                                <a class="nav-link btn-login"
                                   href="/providers/login">

                                    Provider Login

                                </a>

                            </li>

                        </ul>
                    }

                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>

            <div class="text-center">

                <h5>🏠 HomeService</h5>

                <p>
                    Book trusted professionals for your home.
                </p>

                <p>
                    © @DateTime.Now.Year HomeService. All Rights Reserved.
                </p>

            </div>

        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
